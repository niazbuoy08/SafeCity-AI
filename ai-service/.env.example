AI_PROVIDER=demo
# demo | real | gemini
CONFIDENCE_IGNORE_BELOW=60
CONFIDENCE_HIGH_ABOVE=80
PORT=8000

# Required only when AI_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
# NOTE: free-tier keys have a small PER-DAY request quota per model (not just
# per-minute) — see ai-service/README.md if you hit persistent 429 errors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
