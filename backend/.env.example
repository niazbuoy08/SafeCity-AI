# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/safecity

# JWT auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=demo
# demo | real

# CORS
CORS_ORIGIN=http://localhost:5173

# Incident grouping
INCIDENT_GROUPING_WINDOW_SECONDS=30

# Detection thresholds (percent, 0-100)
CONFIDENCE_IGNORE_BELOW=60
CONFIDENCE_HIGH_ABOVE=80

# Seed / default admin
SEED_ADMIN_EMAIL=admin@safecity.ai
SEED_ADMIN_PASSWORD=admin123
SEED_OPERATOR_EMAIL=operator@safecity.ai
SEED_OPERATOR_PASSWORD=operator123
